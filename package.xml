<?xml version="1.0"?>
<package format="3">
  <name>fast_lio</name><version>0.1.0</version>
  <description>ROS2 FAST-LIO2 with degeneracy-aware multisensor SLAM.</description>
  <maintainer email="dev@livoxtech.com">FAST-LIO contributors</maintainer>
  <license>GPL-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>rclcpp</depend><depend>sensor_msgs</depend><depend>nav_msgs</depend>
  <depend>geometry_msgs</depend><depend>visualization_msgs</depend>
  <depend>diagnostic_msgs</depend><depend>std_srvs</depend><depend>tf2_ros</depend>
  <depend>pcl_conversions</depend><depend>cv_bridge</depend><depend>eigen</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
